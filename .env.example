# OpenRouter API Key (Khuyên dùng cho bài lab - có model free :free)
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI API Key (Tùy chọn - fallback nếu OpenRouter bị 429 rate limit)
# OPENAI_API_KEY=sk-proj-...

# Gemini API Key (Tùy chọn - fallback nếu OpenRouter và OpenAI đều không có/hết quota)
# GEMINI_API_KEY=...

# PageIndex API Key (Tùy chọn - dùng cho Task 8: Vectorless RAG fallback)
# PAGEINDEX_API_KEY=pix_...

# Jina API Key (Tùy chọn - dùng cho Task 7: Cross-encoder reranking via Jina API)
# JINA_API_KEY=jina_...

# Task 7-10 provider configuration (all clients are initialized lazily)
RAG_DOMAIN=labour_law_for_young_workers
LANDING_DIR=data/landing
STANDARDIZED_DIR=data/standardized
CHUNKS_PATH=data/index/chunks.jsonl
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=labour_law_documents
CHROMA_DISTANCE_METRIC=cosine
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_BACKEND=auto
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
JINA_RERANK_URL=https://api.jina.ai/v1/rerank
RERANK_TIMEOUT_SECONDS=20
PAGEINDEX_INDEX_ID=
PAGEINDEX_BASE_URL=
PAGEINDEX_TIMEOUT_SECONDS=30
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_TIMEOUT_SECONDS=45
